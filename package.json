{
  "name": "overtime",
  "version": "0.1.0",
  "private": true,
  "description": "When GitHub's free Actions minutes run out, your runners clock in. Billing-aware runs-on routing.",
  "license": "MIT",
  "author": "Shawn Azar",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/action.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs --legal-comments=none && esbuild src/cli.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/cli.cjs --legal-comments=none",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "esbuild": false
  }
}
